# 复制为 .env 后填入真实值；.env 已被 git 忽略，不要提交
# Coze 个人访问令牌
COZE_PAT=pat_xxx
# 鉴权前缀：Coze 要求 Authorization: Bearer pat_xxx
# 若你的代理已去掉前缀，可留空（此时就是 Authorization: pat_xxx）
COZE_AUTH_SCHEME=Bearer
# 智能体 ID
COZE_BOT_ID=
# 业务侧用户标识，同一用户的多轮对话共用
COZE_USER_ID=cozedemo-user
# Coze 开放平台地址
COZE_API_BASE=https://api.coze.cn
# 允许跨域的前端地址，多个用逗号分隔
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
